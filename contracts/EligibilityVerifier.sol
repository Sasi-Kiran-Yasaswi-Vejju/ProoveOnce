pragma solidity ^0.8.24;

interface IGroth16Verifier {
    // Matches the verifier generated by `snarkjs zkey export solidityverifier`
    // for a circuit with 13 public signals (1 output + 12 inputs).
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[13] calldata input
    ) external view returns (bool);
}

interface ICredentialRegistry {
    function check(uint256 commitment, uint256 ax, uint256 ay) external view returns (bool ok, address issuer);
}

/// @title EligibilityVerifier
/// @notice A verifier (bank, embassy...) creates a Query = "field <op> threshold" (optionally
///         AND a second one). The student answers with a zero-knowledge proof. The contract
///         stores only a Yes/No.
contract EligibilityVerifier {
    // indices into the public signals array (output first, then inputs in circuit order)
    uint256 constant S_RESULT = 0;
    uint256 constant S_COMMITMENT = 1;
    uint256 constant S_AX = 2;
    uint256 constant S_AY = 3;
    uint256 constant S_HOLDER = 4;
    uint256 constant S_NONCE = 5;
    uint256 constant S_FIELD_A = 6;
    uint256 constant S_OP_A = 7;
    uint256 constant S_TH_A = 8;
    uint256 constant S_FIELD_B = 9;
    uint256 constant S_OP_B = 10;
    uint256 constant S_TH_B = 11;
    uint256 constant S_USE_B = 12;

    uint8 constant MAX_FIELD = 7;
    uint8 constant MAX_OP = 4; // 0 >=, 1 <=, 2 >, 3 <, 4 ==

    struct QueryInput {
        address expectedHolder; // address(0) = any student may answer
        address requiredIssuer; // address(0) = any registered issuer
        uint8 fieldA;
        uint8 opA;
        uint64 thresholdA;
        bool useSecond;
        uint8 fieldB;
        uint8 opB;
        uint64 thresholdB;
    }

    struct Query {
        address verifier;
        address expectedHolder;
        address requiredIssuer;
        uint8 fieldA;
        uint8 opA;
        uint64 thresholdA;
        bool useSecond;
        uint8 fieldB;
        uint8 opB;
        uint64 thresholdB;
        bool answered;
        bool result;
        address holder;
        uint64 answeredAt;
    }

    IGroth16Verifier public immutable zkVerifier;
    ICredentialRegistry public immutable registry;

    uint256 public nextQueryId = 1;
    mapping(uint256 => Query) public queries;

    event QueryCreated(uint256 indexed queryId, address indexed verifier);
    event QueryAnswered(uint256 indexed queryId, address indexed holder, bool result);

    constructor(address zkVerifier_, address registry_) {
        zkVerifier = IGroth16Verifier(zkVerifier_);
        registry = ICredentialRegistry(registry_);
    }

    function createQuery(QueryInput calldata q) external returns (uint256 id) {
        require(q.fieldA <= MAX_FIELD && q.fieldB <= MAX_FIELD, "bad field");
        require(q.opA <= MAX_OP && q.opB <= MAX_OP, "bad op");
        id = nextQueryId++;
        queries[id] = Query({
            verifier: msg.sender,
            expectedHolder: q.expectedHolder,
            requiredIssuer: q.requiredIssuer,
            fieldA: q.fieldA,
            opA: q.opA,
            thresholdA: q.thresholdA,
            useSecond: q.useSecond,
            fieldB: q.fieldB,
            opB: q.opB,
            thresholdB: q.thresholdB,
            answered: false,
            result: false,
            holder: address(0),
            answeredAt: 0
        });
        emit QueryCreated(id, msg.sender);
    }

    function answerQuery(
        uint256 id,
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[13] calldata s
    ) external {
        Query storage q = queries[id];
        require(q.verifier != address(0), "no such query");
        require(!q.answered, "already answered");
        if (q.expectedHolder != address(0)) require(msg.sender == q.expectedHolder, "wrong holder");

        _checkBinding(q, id, s);
        require(zkVerifier.verifyProof(a, b, c, s), "invalid proof");

        q.answered = true;
        q.result = (s[S_RESULT] == 1);
        q.holder = msg.sender;
        q.answeredAt = uint64(block.timestamp);
        emit QueryAnswered(id, msg.sender, q.result);
    }

    /// @return answered has the student responded yet?
    /// @return result   true = Yes (eligible), false = No
    function getResult(uint256 id) external view returns (bool answered, bool result) {
        Query storage q = queries[id];
        return (q.answered, q.result);
    }

    // The proof is only meaningful if its public inputs are exactly the question this
    // verifier asked, for this student, and the credential is valid and trusted.
    function _checkBinding(Query storage q, uint256 id, uint256[13] calldata s) internal view {
        require(s[S_NONCE] == id, "wrong query id");
        require(s[S_HOLDER] == uint256(uint160(msg.sender)), "proof not bound to sender");
        require(
            s[S_FIELD_A] == q.fieldA && s[S_OP_A] == q.opA && s[S_TH_A] == q.thresholdA,
            "question A mismatch"
        );
        require(s[S_USE_B] == (q.useSecond ? 1 : 0), "second-question flag mismatch");
        require(
            s[S_FIELD_B] == q.fieldB && s[S_OP_B] == q.opB && s[S_TH_B] == q.thresholdB,
            "question B mismatch"
        );

        (bool ok, address issuer) = registry.check(s[S_COMMITMENT], s[S_AX], s[S_AY]);
        require(ok, "credential invalid, expired or revoked");
        if (q.requiredIssuer != address(0)) require(issuer == q.requiredIssuer, "issuer not accepted");
    }
}
