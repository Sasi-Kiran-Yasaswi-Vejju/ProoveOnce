# RPC URL for Arbitrum Sepolia (Ultra-low gas testnet)
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional: Etherscan API key for contract source code verification
ETHERSCAN_API_KEY=
