{
  "name": "prove-once",
  "version": "0.1.0",
  "description": "Prove only once: zero-knowledge yes/no eligibility checks on blockchain",
  "license": "MIT",
  "scripts": {
    "setup:zk": "bash scripts/setup.sh",
    "setup:zk:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "compile": "hardhat compile",
    "demo": "hardhat run scripts/demo.js",
    "test": "hardhat test",
    "server": "node scripts/server.js",
    "ui": "npm --prefix frontend run dev",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:arbitrum": "hardhat run scripts/deploy.js --network arbitrumSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "snarkjs": "^0.7.4"
  }
}
